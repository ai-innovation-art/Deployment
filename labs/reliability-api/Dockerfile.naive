# Naive Dockerfile — used in Lab 2 to demonstrate build cache misses and unoptimized layer order
FROM python:3.12-slim

WORKDIR /app

# Naive flaw 1: Copying everything before installing dependencies breaks build cache on any code edit
COPY . .

# Naive flaw 2: Uncached pip install, runs as root, no multi-stage separation
RUN pip install -r requirements.txt

# Naive flaw 3: Runs as default root user (UID 0)
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
